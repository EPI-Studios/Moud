{
  "schemaVersion": 1,
  "id": "moud",
  "version": "${version}",
  "name": "Moud",
  "description": "build a game inside minecraft with scripts",
  "authors": ["Meekiavelique"],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["com.meekdev.moud.mod.MoudMod"],
    "client": ["com.meekdev.moud.mod.client.MoudClient"]
  },
  "mixins": ["moud.mixins.json"],
  "accessWidener": "moud.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "amnetic": "*",
    "bkun": "*",
    "resona": "*"
  }
}
