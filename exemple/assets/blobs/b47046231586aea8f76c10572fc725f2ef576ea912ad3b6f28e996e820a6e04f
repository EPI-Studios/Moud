#stage fragment

in vec2 texCoord;
out vec4 fragColor;

uniform vec3 moud_skyTopColor;
uniform vec3 moud_skyHorizonColor;
uniform vec3 moud_skySunriseColor;
uniform float moud_skySunriseStrength;
uniform float moud_time01;

// @expose min=0.2 max=3 step=0.05 label=Gamma
uniform float sky_gamma;

// @expose min=0 max=2 step=0.05 label=Sun Strength
uniform float sun_strength;

void main() {
    vec2 uv = texCoord;
    float t = clamp(uv.y, 0.0, 1.0);
    float g = max(0.01, sky_gamma);
    vec3 col = mix(moud_skyHorizonColor, moud_skyTopColor, pow(t, g));

    float sun = exp(-pow((uv.x - 0.5) * 6.0, 2.0)) * exp(-pow((uv.y - 0.55) * 6.0, 2.0));
    float sunrise = max(0.0, sin(moud_time01 * 6.2831853));
    col += moud_skySunriseColor * (moud_skySunriseStrength * sunrise) * (sun * sun_strength);

    fragColor = vec4(col, 1.0);
}
