#stage fragment

in vec2 texCoord;
out vec4 fragColor;

// @expose label=Albedo
uniform sampler2D albedo;

// @expose color label=Tint
uniform vec3 tint;

// @expose min=0 max=1 step=0.01 label=Opacity
uniform float opacity;

void main() {
    vec2 uv = fract(texCoord);
    vec4 tex = texture(albedo, uv);
    vec3 rgb = tex.rgb * tint;
    float a = tex.a * opacity;
    fragColor = vec4(rgb, a);
}
