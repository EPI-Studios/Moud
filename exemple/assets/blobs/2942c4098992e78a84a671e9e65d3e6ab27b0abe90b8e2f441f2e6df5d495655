#stage fragment

in vec2 texCoord;
out vec4 fragColor;

uniform vec3 moud_skyTopColor;
uniform vec3 moud_skyHorizonColor;
uniform vec3 moud_skySunriseColor;
uniform float moud_skySunriseStrength;
uniform float moud_time01;
uniform vec3 moud_camForward;
uniform vec3 moud_camRight;
uniform vec3 moud_camUp;
uniform float moud_fovDeg;
uniform float moud_aspectRatio;

// @expose min=0.2 max=3 step=0.05 label=Gamma
uniform float sky_gamma;

// @expose min=0 max=2 step=0.05 label=Sun Strength
uniform float sun_strength;

void main() {
    // Reconstruct world-space ray direction from screen UV + camera orientation.
    // This keeps the sky fixed in the world as the camera rotates.
    vec2 ndc = texCoord * 2.0 - 1.0;
    float tanHalfFov = tan(radians(moud_fovDeg) * 0.5);
    vec3 rayDir = normalize(
        moud_camForward
        + moud_camRight * (ndc.x * moud_aspectRatio * tanHalfFov)
        + moud_camUp    * (ndc.y * tanHalfFov)
    );

    // World-space elevation: -1=straight down, +1=straight up.
    float elevation = rayDir.y;
    float t = clamp(elevation * 0.5 + 0.5, 0.0, 1.0);
    float g = max(0.01, sky_gamma);
    vec3 col = mix(moud_skyHorizonColor, moud_skyTopColor, pow(t, g));

    // Sun: moves across the sky based on time.
    // At time01=0/1 it is at the horizon, at 0.25 it is overhead.
    float sunAngle = moud_time01 * 6.2831853;
    vec3 sunDir = normalize(vec3(cos(sunAngle), sin(sunAngle), 0.3));
    float sunDot = max(0.0, dot(rayDir, sunDir));
    float sun = exp(-pow((1.0 - sunDot) * 10.0, 2.0));
    float sunrise = clamp(1.0 - abs(sunDir.y) * 2.0, 0.0, 1.0);
    col += moud_skySunriseColor * (moud_skySunriseStrength * sunrise) * (sun * sun_strength);

    fragColor = vec4(col, 1.0);
}
